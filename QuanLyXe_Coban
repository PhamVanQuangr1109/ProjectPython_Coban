danh_sach_xe = []
next_id = 1

TIEN_XE_MAY = 5000
TIEN_O_TO = 15000

def display_menu():
    print("\n" + "=" * 48)
    print("         QUẢN LÝ BÃI XE - SMART PARKING")
    print("=" * 48)
    print("1. Check-in (Đăng ký xe vào)")
    print("2. Báo cáo tồn kho (Hiển thị danh sách)")
    print("3. Tìm kiếm xe (Theo biển số)")
    print("4. Check-out (Xử lý xe ra & Tính phí)")
    print("5. Thoát chương trình")
    print("=" * 48)

def check_in():
    global next_id
    
    plate = input("Nhập biển số xe: ").strip()
    if not plate:
        print("[Lỗi]: Biển số xe không được để trống!")
        return
        
    for xe in danh_sach_xe:
        if xe['plate'].lower() == plate.lower():
            print(f"[Lỗi]: Biển số {plate} đã tồn tại trong hệ thống!")
            return

    # Loại xe: 1 - Xe máy, 2 - Ô tô
    while True:
        try:
            xe_type = int(input("Nhập loại xe (1: Xe máy, 2: Ô tô): "))
            if xe_type in [1, 2]:
                break
            print("[Lỗi]: Loại xe chỉ nhận giá trị 1 hoặc 2!")
        except ValueError:
            print("[Lỗi]: Vui lòng nhập số nguyên!")

    # Giờ vào
    while True:
        try:
            entry_time = int(input("Nhập giờ vào (0-23): "))
            if 0 <= entry_time <= 23:
                break
            print("[Lỗi]: Giờ vào phải từ 0 đến 23!")
        except ValueError:
            print("[Lỗi]: Vui lòng nhập số nguyên!")

    them_xe = {
        'id': next_id,
        'plate': plate,
        'type': xe_type,
        'entry_time': entry_time
    }

    danh_sach_xe.append(them_xe)
    print(f"Đăng ký xe {plate} thành công!")
    next_id += 1

def report():
    if not danh_sach_xe:
        print("\n[Thông báo: Bãi xe hiện đang trống!]")
        return

    print("\nID     | Biển số xe      | Loại xe   | Giờ vào")
    print("-" * 48)

    for xe in danh_sach_xe:
        loai_str = "Xe máy" if xe['type'] == 1 else "Ô tô"
        print(f"{xe['id']:<6} | {xe['plate']:<15} | {loai_str:<9} | {xe['entry_time']}")

def find_xe():
    bien_so_tim = input("\nNhập biển số xe cần tìm: ").strip()
    if not bien_so_tim:
        print("[Lỗi]: Chưa nhập biển số!")
        return

    for xe in danh_sach_xe:
        if xe['plate'].lower() == bien_so_tim.lower():
            print(f"Thông tin chi tiết: {xe}")
            return
            
    print(f"[Lỗi]: Không tìm thấy biển số {bien_so_tim} trong hệ thống!")

def check_out():
    xe_ra = input("\nNhập biển số xe cần ra: ").strip()
    if not xe_ra:
        print("[Lỗi]: Chưa nhập biển số!")
        return

    for xe in danh_sach_xe:
        if xe['plate'].lower() == xe_ra.lower():
            while True:
                try:
                    gio_ra = int(input("Nhập giờ ra: "))
                    if gio_ra < xe['entry_time']:
                        print("[Lỗi]: Giờ ra phải sau hoặc bằng giờ vào!")
                        return
                    break
                except ValueError:
                    print("[Lỗi]: Vui lòng nhập số nguyên!")

            don_gia = TIEN_O_TO if xe['type'] == 2 else TIEN_XE_MAY
            thoi_gian_gui = gio_ra - xe['entry_time']
            tong_phi = don_gia if thoi_gian_gui == 0 else thoi_gian_gui * don_gia

            print(f"Tổng phí phải trả: {tong_phi} VNĐ")
            print(f"[Thành công]: Đã xóa xe ID {xe['id']} thành công!")
            danh_sach_xe.remove(xe)
            return

    print(f"[Lỗi]: Không tìm thấy biển số {xe_ra} trong hệ thống!")

def main():
    while True:
        display_menu()
        choice = input("Nhập lựa chọn của bạn (1-5): ").strip()
        
        if choice == '1':
            check_in()
        elif choice == '2':
            report()
        elif choice == '3':
            find_xe()
        elif choice == '4':
            check_out()
        elif choice == '5':
            print("Cảm ơn đã sử dụng chương trình!")
            break
        else:
            print("[Lỗi]: Lựa chọn không hợp lệ, vui lòng chọn từ 1 đến 5!")

if __name__ == '__main__':
    main()
